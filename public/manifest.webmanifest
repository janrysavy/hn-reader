{
  "name": "HN Reader",
  "short_name": "HN Reader",
  "description": "A mobile-first Hacker News reader with comfortable typography and collapsible comment threads.",
  "lang": "en",
  "dir": "ltr",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f7f8",
